# Load the SCOM OperationsManager module
Import-Module OperationsManager

# Check for any active SCOM management group connections
$connections = Get-SCOMManagementGroupConnection

if ($connections) {
    Write-Host "Active SCOM Management Group Connection(s) Found:"
    $connections | Format-Table ComputerName, ConnectionState, UserName
} else {
    Write-Host "No active SCOM connections found."
}
